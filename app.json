      },
      "config": {
        "googleMaps": {
          "apiKey": "**************"
        }
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.DIVINA"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    }
  }
}
